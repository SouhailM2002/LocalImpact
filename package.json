{
  "name": "localimpact",
  "private": true,
  "packageManager": "pnpm@10.0.0",
  "engines": {
    "node": "^20.19.0 || ^22.13.0 || >=24"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "lint:eslint": "eslint .",
    "dependency:check": "depcruise --config .dependency-cruiser.cjs apps/web/src packages",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:e2e": "pnpm --filter @localimpact/web... build && pnpm --filter @localimpact/web test:e2e",
    "db:migrate:deploy": "pnpm --filter @localimpact/db db:migrate:deploy",
    "db:migrate:status": "pnpm --filter @localimpact/db db:migrate:status"
  },
  "devDependencies": {
    "@eslint-react/eslint-plugin": "^5.30.6",
    "@eslint/js": "^10.0.1",
    "@next/eslint-plugin-next": "^16.4.6",
    "dependency-cruiser": "^18.9.0",
    "eslint": "^10.15.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "turbo": "^2.5.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.74.0"
  }
}
