# Copy this file to .env and replace the local-only password placeholder.
POSTGRES_USER=localimpact_dev
POSTGRES_PASSWORD=replace-with-a-local-password
POSTGRES_PORT=5432

# Keep the password in DATABASE_URL the same as POSTGRES_PASSWORD.
DATABASE_URL=postgresql://localimpact_dev:replace-with-a-local-password@localhost:5432/localimpact?schema=public
