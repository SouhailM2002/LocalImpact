# Copy this file to .env and replace the local-only password placeholder.
POSTGRES_USER=localimpact_dev
POSTGRES_PASSWORD=LocalImpact123

# Keep the password in DATABASE_URL the same as POSTGRES_PASSWORD.
DATABASE_URL=postgresql://localimpact_dev:LocalImpact123@localhost:5432/localimpact?schema=public

# Better Auth session signing; use a unique secret of at least 32 characters.
BETTER_AUTH_SECRET=replace-with-a-random-secret-at-least-32-characters
BETTER_AUTH_URL=http://localhost:3000
