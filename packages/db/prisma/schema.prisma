generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  USER
  RESPONSABLE
  ADMIN
}

enum SignalementStatus {
  NOUVEAU
  PRIS_EN_CHARGE
  EN_COURS
  RESOLU
}

model User {
  id            String      @id @default(cuid())
  name          String
  email         String      @unique
  passwordHash  String
  role          UserRole    @default(USER)
  createdAt     DateTime    @default(now())

  createdReports   Signalement[] @relation("SignalementCreator")
  assignedReports  Signalement[] @relation("SignalementResponsable")
  soutiens         Soutien[]
  historiques      Historique[]
  commentaires     Commentaire[]

  @@index([role])
}

model Signalement {
  id                       String             @id @default(cuid())
  title                    String
  description              String
  category                 String
  location                 String
  photoUrl                 String?
  status                   SignalementStatus  @default(NOUVEAU)
  creatorId                String
  responsableId            String?
  interventionDescription  String?
  createdAt                DateTime           @default(now())
  updatedAt                DateTime           @updatedAt
  resolvedAt               DateTime?

  creator       User          @relation("SignalementCreator", fields: [creatorId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  responsable   User?         @relation("SignalementResponsable", fields: [responsableId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  soutiens      Soutien[]
  historiques   Historique[]
  commentaires  Commentaire[]

  @@index([title])
  @@index([category, status])
  @@index([location, status])
  @@index([status, createdAt])
  @@index([creatorId])
  @@index([responsableId, status])
  @@index([resolvedAt])
}

model Soutien {
  id             String      @id @default(cuid())
  userId         String
  signalementId  String
  createdAt      DateTime    @default(now())

  user         User        @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  signalement  Signalement @relation(fields: [signalementId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@unique([userId, signalementId])
  @@index([signalementId])
}

model Historique {
  id             String             @id @default(cuid())
  signalementId  String
  authorId       String
  previousStatus SignalementStatus
  newStatus      SignalementStatus
  description    String?
  createdAt      DateTime           @default(now())

  signalement  Signalement @relation(fields: [signalementId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  author       User        @relation(fields: [authorId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([signalementId, createdAt])
  @@index([authorId])
}

model Commentaire {
  id             String      @id @default(cuid())
  signalementId  String
  authorId       String
  content        String
  createdAt      DateTime    @default(now())

  signalement  Signalement @relation(fields: [signalementId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  author       User        @relation(fields: [authorId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([signalementId, createdAt])
  @@index([authorId])
}
