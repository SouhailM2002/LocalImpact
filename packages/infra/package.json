{
  "name": "@localimpact/infra",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "LocalImpact infrastructure implementations of application interfaces.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc --project tsconfig.build.json",
    "lint": "eslint . --no-error-on-unmatched-pattern",
    "typecheck": "tsc --noEmit --project tsconfig.json && tsc --noEmit --project tests/tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@localimpact/application": "workspace:*",
    "@localimpact/domain": "workspace:*"
  },
  "devDependencies": {
    "vitest": "^4.1.12"
  }
}
