{
  "name": "@localimpact/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Next.js App Router application and composition root for LocalImpact.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "lint": "eslint . --no-error-on-unmatched-pattern",
    "typecheck": "next typegen && tsc --noEmit --project tsconfig.json && tsc --noEmit --project tests/tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@better-auth/prisma-adapter": "1.7.28",
    "@localimpact/application": "workspace:*",
    "@localimpact/db": "workspace:*",
    "@localimpact/domain": "workspace:*",
    "@localimpact/infra": "workspace:*",
    "@localimpact/ui": "workspace:*",
    "@next/env": "^16.4.6",
    "better-auth": "1.7.28",
    "next": "^16.4.6",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "server-only": "^0.0.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.18",
    "@types/node": "^20.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "postcss": "^8.5.33",
    "tailwindcss": "^4.1.18",
    "vitest": "^4.1.12"
  }
}
